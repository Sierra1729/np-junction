# Database
DATABASE_URL="file:./dev.db"

# Google Agricultural Understanding API Key
# Sign up / get allowlisted at https://developers.google.com/agricultural-understanding
AGRI_UNDERSTANDING_API_KEY=""

# Data mode: "mock" (default, runs offline with realistic fixtures) or "live"
AGRI_DATA_MODE="mock"

# Outgoing API rate limit concurrency (default: 3)
AGRI_API_CONCURRENCY="3"

# Cache TTL in hours (default: 24)
AGRI_CACHE_TTL_HOURS="24"

# NextAuth / App Secret
NEXTAUTH_SECRET="krishisatya_production_secret_key_change_me_in_prod_12345678"
NEXTAUTH_URL="http://localhost:3000"
